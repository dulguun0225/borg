/.claude/settings.local.json
/graphify-out
# The credential the real-model test and a demo run read. Ignored before the
# file exists, so a token pasted into it cannot be committed by accident.
/factory/secrets.local
/temp.md
# The unattended loop's log, per README.
/loop.log
__pycache__
factory/factory
.env
# The client's build output, embedded by factory/clientdist. .gitkeep is
# what lets the directory embed on a fresh clone before the build has run.
/factory/clientdist/browser/*
!/factory/clientdist/browser/.gitkeep
node_modules
# The Angular build's own cache, written beside the client's sources.
/factory/client/.angular